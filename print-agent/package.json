{
  "name": "print-agent",
  "productName": "Print Agent",
  "version": "1.4.2",
  "type": "module",
  "description": "Print Agent - Windows Desktop Print Spooler & Printer Automation",
  "author": "EasyToPrint Cloud Technologies",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build:icons": "node scripts/generate-icons.mjs",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "build": "npm run build:icons && npm run build:renderer && npm run build:main",
    "prestart": "npm run build",
    "start": "node scripts/ensure-electron.mjs && electron .",
    "verify:electron": "node scripts/ensure-electron.mjs",
    "fix:electron": "node scripts/fix-electron.mjs",
    "postinstall": "node scripts/ensure-electron.mjs",
    "pack": "npm run build && electron-builder --dir",
    "prebuild:win": "npm run build",
    "build:win": "electron-builder --win --x64",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.printagent.app",
    "productName": "Print Agent",
    "artifactName": "print-agent-Setup-${version}.exe",
    "copyright": "Copyright © 2026 EasyToPrint",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "public/assets/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@napi-rs/**/*",
      "**/node_modules/pdfjs-dist/**/*",
      "**/node_modules/pdf-to-printer/**/*",
      "**/node_modules/printer/**/*",
      "**/node_modules/sharp/**/*",
      "**/node_modules/sqlite3/**/*",
      "**/node_modules/serialport/**/*",
      "**/node_modules/puppeteer/**/*",
      "**/*.{node,dll,exe}"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "build",
        "to": "build"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Print Agent",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "lucide-react": "^0.546.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^8.3.0"
  }
}
