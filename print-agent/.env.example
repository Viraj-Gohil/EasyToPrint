# Print Agent Production Defaults (Bundled via extraResources into process.resourcesPath)
AGENT_DEFAULT_SERVER_URL=https://easytoprint.devpixel.space
# Optional explicit HTTPS connectivity health-check endpoint override (defaults to <serverUrl>/api/health)
# AGENT_HEALTH_CHECK_URL=https://easytoprint.devpixel.space/api/health
AGENT_POLL_INTERVAL_MS=5000
AGENT_SPOOLER_TIMEOUT_MS=30000
AGENT_AUTO_START_ON_BOOT=true
AGENT_LOG_LEVEL=INFO
